{
  "name": "imap-email-notifier-bot",
  "version": "1.0.0",
  "description": "Self-hosted Telegram bot that notifies you of every email in any folder of any IMAP mailbox",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test:integration": "vitest run --config test/integration/vitest.config.ts"
  },
  "keywords": [
    "imap",
    "telegram",
    "email",
    "notifications",
    "self-hosted"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "node-gyp": "^13.0.1",
    "nodemailer": "^9.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
